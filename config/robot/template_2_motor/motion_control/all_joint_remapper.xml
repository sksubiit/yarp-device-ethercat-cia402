<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE devices PUBLIC "-//YARP//DTD yarprobotinterface 3.0//EN" "http://www.yarp.it/DTD/yarprobotinterfaceV3.0.dtd">

<device xmlns:xi="http://www.w3.org/2001/XInclude" name="all_joints_mc" type="controlboardremapper">
    <param name="axesNames">(joint1 joint2)</param>
    <param name="period"> 0.010 </param>
    
    <action phase="startup" level="6" type="attach">
        <paramlist name="networks">
            <elem name="net1">joint1_hw</elem>
            <elem name="net2">joint2_hw</elem>
        </paramlist>
    </action>
    
    <action phase="shutdown" level="20" type="detach" />
</device>
