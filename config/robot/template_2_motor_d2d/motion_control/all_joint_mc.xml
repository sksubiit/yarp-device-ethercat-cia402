<device xmlns:xi="http://www.w3.org/2001/XInclude" name="all_joints_mc" type="CiA402MotionControl">
    <!-- NIC connected to drive 1. Drive 2 is reached through the EtherCAT OUT port of drive 1. -->
    <param name="ifname">"enx08beac363dca"</param>
    <param name="num_axes">2</param>
    <param name="first_slave">1</param>
    <param name="period">1e-3</param>
    <param name="pdo_timeout_us">10000</param>
    <param name="enable_dc">true</param>
    <param name="dc_shift_ns">0</param>

    <param name="axes_names">( "traction" "steering" )</param>
    <param name="inverted_motion_sense_direction">( false false )</param>

    <param name="enc1_mount">( "motor" "motor" )</param>
    <param name="enc2_mount">( "joint" "joint" )</param>
    <param name="position_feedback_motor">( "6064" "6064" )</param>
    <param name="velocity_feedback_motor">( "606C" "606C" )</param>
    <param name="position_feedback_joint">( "6064" "6064" )</param>
    <param name="velocity_feedback_joint">( "606C" "606C" )</param>

    <!-- 0x2002 position control strategy: true => 1 (Simple PID), false => 2 (Cascaded PID). -->
    <param name="use_simple_pid_mode">true</param>
    <param name="simple_pid_kp_nm_per_deg">( 0.6981 0.6981 )</param>
    <param name="simple_pid_kd_nm_s_per_deg">( 0.01745 0.01745 )</param>

    <param name="position_window_deg">( 0.1 0.1 )</param>
    <param name="timing_window_ms">( 100 100 )</param>
    <!-- Keep the real position limits in the drives/Oblac and read them at startup.
         Very large degree limits can saturate the int32 encoder-count range used by SDO 0x607D. -->
    <param name="pos_limit_min_deg">( -180.0 -180.0 )</param>
    <param name="pos_limit_max_deg">( 180.0 180.0 )</param>
    <param name="vel_limit_min_deg_s">( -500.0 -100.0 )</param>
    <param name="vel_limit_max_deg_s">( 500.0 100.0 )</param>
    <param name="use_position_limits_from_config">( false false )</param>
</device>
